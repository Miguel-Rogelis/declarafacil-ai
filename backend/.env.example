# Copia este archivo como .env (en esta misma carpeta) y pega tu llave de OpenRouter.
# La llave la creas gratis en https://openrouter.ai/keys (no pide tarjeta). Nunca subas el .env a GitHub.
OPENROUTER_API_KEY=
# Clave para guardar cambios y ver métricas en «Configuración» (inventa una)
ADMIN_TOKEN=
# Correos (separados por coma) que pueden editar la configuración y ver métricas iniciando sesión, sin la clave
ADMIN_EMAILS=
# Dónde guardar configuración editada, métricas y cupo: memoria | archivo (en ALMACEN_DIR) | supabase
# (por defecto: supabase si hay SUPABASE_SERVICE_ROLE_KEY, si no memoria)
ALMACEN=archivo
ALMACEN_DIR=./estado
# Modelos: gratis (por defecto) o pago (Claude Haiku 4.5 con respaldo, proveedores sin retención de datos)
PERFIL_MODELOS=gratis
# 1 = pedir a OpenRouter solo proveedores que no guardan ni entrenan con los datos (siempre activo en el perfil de pago)
OPENROUTER_SIN_RETENCION=0
# Cupo de IA (por defecto 15/45 con modelos gratis y 40/3000 con los de pago)
# IA_POR_HORA=
# IA_TOPE_DIARIO=
